{
  "name": "cao3",
  "private": true,
  "version": "0.1.0",
  "description": "CAO3 — dépôt racine. L'application CAO web est dans cao_web/ ; ce fichier ne sert qu'à déléguer les commandes depuis la racine.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "npm --prefix cao_web install",
    "dev": "npm --prefix cao_web run dev",
    "build": "npm --prefix cao_web run build",
    "preview": "npm --prefix cao_web run preview",
    "test": "npm --prefix cao_web test",
    "test:watch": "npm --prefix cao_web run test:watch",
    "typecheck": "npm --prefix cao_web run typecheck"
  }
}
